{
  "name": "checkmyresume-server",
  "version": "1.0.0",
  "type": "module",
  "description": "CheckMyResume API Server - AI-powered resume analysis backend",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch --env-file=../.env src/index.js",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:migrate": "npx prisma migrate dev",
    "db:studio": "npx prisma studio",
    "worker:scraping": "node --env-file=../.env src/workers/scrapingWorker.js",
    "worker:pdf": "node --env-file=../.env src/workers/pdfWorker.js"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "bullmq": "^5.34.0",
    "connect-redis": "^8.0.1",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.18.1",
    "express-validator": "^7.2.1",
    "groq-sdk": "^0.14.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "multer": "^2.0.1",
    "pdf-parse": "^2.4.5",
    "puppeteer": "^24.9.0",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "prisma": "^6.9.0"
  }
}
