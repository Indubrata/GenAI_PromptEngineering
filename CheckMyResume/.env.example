# ============================================
# CheckMyResume - Environment Variables
# ============================================
# Copy this file to .env and fill in your keys

# --- AI (Groq) ---
GROQ_API_KEY=your_groq_api_key_here

# --- Bright Data (LinkedIn Scraping) ---
BRIGHT_DATA_API_KEY=your_bright_data_api_key_here
BRIGHT_DATA_CUSTOMER_ID=your_bright_data_customer_id_here

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/checkmyresume

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Session ---
SESSION_SECRET=change_this_to_a_random_64_character_string

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Client ---
VITE_API_URL=


# --- Deployment (Render) ---
# Public URL(s) of the client, comma-separated, no trailing slash. Needed for CORS + sockets.
# CLIENT_URL=https://checkmyresume.onrender.com
# Only set to true if the React app is hosted on a DIFFERENT origin than the API
# (e.g. Render Static Site + separate Web Service). Not needed when the API serves the client.
# CROSS_SITE_COOKIES=true
# Only needed if the client is hosted separately: full API origin, baked in at client BUILD time.
# VITE_API_URL=https://your-api.onrender.com
# Optional: path to a Chrome/Chromium binary for PDF export (defaults to Puppeteer's own Chrome)
# BROWSER_EXECUTABLE_PATH=
