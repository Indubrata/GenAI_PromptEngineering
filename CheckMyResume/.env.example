# ============================================
# CheckMyResume - Environment Variables
# ============================================
# Copy this file to .env and fill in your keys

# --- AI (Groq) ---
GROQ_API_KEY=your_groq_api_key_here

# --- Bright Data (LinkedIn Scraping) ---
BRIGHT_DATA_API_KEY=your_bright_data_api_key_here
BRIGHT_DATA_CUSTOMER_ID=your_bright_data_customer_id_here

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/checkmyresume

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Session ---
SESSION_SECRET=change_this_to_a_random_64_character_string

# --- Server ---
PORT=3001
NODE_ENV=development

# --- Client ---
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001
